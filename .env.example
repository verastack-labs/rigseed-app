# Point the dev server at a real qBittorrent instead of the mock.
#
# Copy to .env.local and set it to a daemon you can reach. The dev server
# proxies /api to it, which keeps the session cookie same-origin: without the
# proxy the page would need qBittorrent's CSRF and host-header checks turned
# off, and asking somebody to weaken their daemon to run our dev server is not
# a reasonable trade.
#
# Unset, the app uses the mock and nothing else changes.
VITE_QBT_URL=http://127.0.0.1:8080
VITE_QBT_USER=admin
VITE_QBT_PASS=
