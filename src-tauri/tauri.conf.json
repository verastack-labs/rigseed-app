{
  "$schema": "../node_modules/@tauri-apps/cli/config.schema.json",
  "productName": "rigseed",
  "version": "../package.json",
  "identifier": "dev.verastack.rigseed",
  "build": {
    "frontendDist": "../dist",
    "devUrl": "http://localhost:1420",
    "beforeDevCommand": "pnpm run dev",
    "beforeBuildCommand": "pnpm run build"
  },
  "app": {
    "windows": [
      {
        "title": "rigseed",
        "width": 1100,
        "height": 700,
        "minWidth": 1100,
        "minHeight": 700,
        "center": true,
        "resizable": true,
        "fullscreen": false,
        "backgroundColor": "#191A1C"
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "createUpdaterArtifacts": true,
    "externalBin": ["binaries/qbittorrent-nox"],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "android": {
      "debugApplicationIdSuffix": ".debug"
    }
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDM0QjI2NTIyNkJEODM0RTMKUldUak5OaHJJbVd5TkZxTit3bDZZOS8wd3A2aStZOUswcldEcGpHRmJyZ2tUL3QxWlNxTkFzSzgK",
      "endpoints": [
        "https://github.com/verastack-labs/rigseed-app/releases/latest/download/latest.json"
      ],
      "windows": {
        "installMode": "passive"
      }
    }
  }
}
